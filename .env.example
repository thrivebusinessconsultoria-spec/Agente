# CONFIGURAÇÕES DA THRIVE BUSINESS

# 1. Chave da API do Google Gemini
GEMINI_API_KEY="cole_sua_chave_aqui"

# 2. Credenciais de E-mail (Gmail)
SENDER_EMAIL="seu_email@gmail.com"
SENDER_PASSWORD="sua_senha_app_aqui"

# 3. E-mail do Consultor
CONSULTANT_EMAIL="consultor@empresa.com"

# 4. Servidor SMTP (Gmail)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587

# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Substitua os valores pelos reais
# 3. NUNCA faça commit do .env
